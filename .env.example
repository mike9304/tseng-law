# Public site URL
NEXT_PUBLIC_SITE_URL=https://tseng-law.com
SITE_URL=https://tseng-law.com

# Optional search-engine ownership verification tokens (not API keys)
NAVER_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=

# Postgres for Visual CMS 2.0
DATABASE_URL=postgresql://username:password@localhost:5432/hojeong_visual_cms?schema=public

# CMS admin login
CMS_ADMIN_USERNAME=replace-with-admin-username
CMS_ADMIN_PASSWORD=replace-with-a-long-random-password
CMS_SESSION_SECRET=replace-with-a-long-random-secret
# Optional JSON array for separate builder Basic Auth accounts.
# Add matching roles in /admin-builder/users before using them for approvals.
# BUILDER_BASIC_AUTH_USERS=[{"username":"reviewer","password":"replace-with-reviewer-password"}]

# Vercel Blob storage for live CMS publishing
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token

# Builder security and observability
BUILDER_ALLOWED_ORIGINS=https://tseng-law.com
BUILDER_ADMIN_SESSION_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAY_SAMPLE_RATE=0.05

# Vercel deployment/domain operations
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Stripe payments and billing webhooks
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_DOCUMENT_STRIPE_WEBHOOK_SECRET=

# Bookings calendar sync OAuth
OAUTH_STATE_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://tseng-law.com/api/builder/bookings/calendar-sync/oauth-callback
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_REDIRECT_URI=https://tseng-law.com/api/builder/bookings/calendar-sync/oauth-callback
MS_OAUTH_TENANT=common

# Bookings Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Marketing email delivery
# MARKETING_EMAIL_PROVIDER can be unset, resend, mailchimp-transactional, or stub.
MARKETING_EMAIL_PROVIDER=
RESEND_API_KEY=
FORMS_EMAIL_FROM=forms@hoveringlaw.com.tw
MAILCHIMP_TRANSACTIONAL_API_KEY=
MAILCHIMP_TRANSACTIONAL_API_URL=
MAILCHIMP_MARKETING_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_MARKETING_API_URL=

# AI consultation mail intake
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
NOTIFY_EMAIL=replace-with-default-notify-email
CONSULTATION_NOTIFY_EMAIL=replace-with-consultation-review-email
NEXT_PUBLIC_CONSULTATION_PUBLIC_EMAIL=wei@hoveringlaw.com.tw
CONSULTATION_LOG_DIR=./runtime-data/consultation-logs
HCAPTCHA_SECRET=
TURNSTILE_SECRET=

# Optional LLM provider for AI consultation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_GENERATION_MODEL=gpt-4o-mini
OPENAI_PAGE_SPEC_MODEL=gpt-4o-mini
OPENAI_TEXT_ASSISTANT_MODEL=gpt-4o-mini
OPENAI_CODE_ASSISTANT_MODEL=gpt-4o-mini
OPENAI_SECTION_ASSISTANT_MODEL=gpt-4o-mini
TRANSLATION_PROVIDER=
DEEPL_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_TRANSLATION_INPUT_USD_PER_1M_TOKENS=
OPENAI_TRANSLATION_OUTPUT_USD_PER_1M_TOKENS=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Internal security/webhook secrets
BUILDER_WEBHOOK_SECRET=
CRM_WEBHOOK_SECRET=
# Dedicated HMAC secret for signed marketing click destinations.
MARKETING_TRACKING_SECRET=
# Dedicated HMAC secret for short-lived private form-upload download URLs.
FORM_UPLOAD_SIGNING_SECRET=
# Dedicated HMAC secret for signed booking-management links (minimum 32 bytes).
BOOKING_MANAGE_TOKEN_SECRET=
# Dedicated HMAC secret for public experiment assignment proofs (minimum 32 bytes).
EXPERIMENT_ASSIGNMENT_SECRET=
NEXTAUTH_SECRET=
COMMERCE_PAYMENT_WEBHOOK_SECRET=
COMMERCE_SANDBOX_CARD_WEBHOOK_SECRET=
BUILDER_INTERNAL_NOTIFY_SECRET=
CONSULTATION_EVAL_SECRET=
CONSULTATION_PURGE_SECRET=
