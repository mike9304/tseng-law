  "caveat_pattern": "(?i:^\\s*[”\"(]*(?:dock|däremot|ändå|trots\\s+det)\\b)",
  "hypo_pattern": "(?i:^\\s*[”\"(]*(?:anta\\s+att|föreställ\\s+dig|tänk\\s+dig)\\b)",
  "formula_close_pattern": "(?i:denna\\s+artikel\\s+(?:ger|innehåller)\\s+(?:endast\\s+)?allmän\\s+information|vår\\s+byrå\\s+kan\\s+hjälpa)",
  "citation_pattern": "(?i:\\b(?:artikel|artiklar|art\\.)\\s*\\d+)"
}
