  "abbreviations": ["dr", "prof", "kap", "st", "s", "nr", "prop", "bl.a", "bl. a", "dvs", "d.v.s", "t.ex", "t. ex", "m.fl", "m. fl", "m.m", "m. m", "fr.o.m", "t.o.m"],
